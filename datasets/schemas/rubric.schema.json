{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-qa.local/schemas/ai-qa/rubric.schema.json",
  "title": "AI QA Rubric",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "rubric_id", "dimensions", "pass_threshold"],
  "properties": {
    "version": { "type": "string" },
    "rubric_id": { "type": "string" },
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["weight", "description", "scoring"],
        "properties": {
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": { "type": "string" },
          "scoring": { "type": "object" },
          "applicable_to": {
            "type": "array",
            "items": { "type": "string" }
          },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "pass_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "safety_hard_gate": { "type": "boolean" }
  }
}
