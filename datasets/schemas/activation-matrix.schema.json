{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-qa.local/schemas/ai-qa/activation-matrix.schema.json",
  "title": "AI QA Activation Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["cycle_name", "dataset_version", "suite", "run_id", "agents"],
  "properties": {
    "cycle_name": { "type": "string" },
    "dataset_version": { "type": "string" },
    "suite": {
      "enum": ["smoke", "release", "rag_release", "agentic_release", "model_change", "red_team", "nightly"]
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}-[0-9]{3}$"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agent", "status", "reason", "parallel_group"],
        "properties": {
          "agent": { "type": "string" },
          "status": { "enum": ["required", "skipped"] },
          "reason": { "type": "string" },
          "blocking_gate": { "type": ["string", "null"] },
          "parallel_group": {
            "enum": ["setup", "service", "final", "model", "none"]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
